cabal-version:      3.14
name:               flappy-bird
version:            0.1.0.0
-- synopsis:
-- description:
homepage:           https://github.com/abdivasiyev/flappy-bird
license:            Apache-2.0
license-file:       LICENSE
author:             Asliddin Abdivasiyev
maintainer:         asliddin.abdivasiyev@gmail.com
-- copyright:
category:           Game
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall
    default-extensions:
        DataKinds
        OverloadedRecordDot
        OverloadedStrings

executable flappy-bird
    import:           warnings
    main-is:          Main.hs
    -- other-modules:
    -- other-extensions:
    build-depends:    base ^>=4.21.0.0
                    , text
                    , sdl2
                    , sdl2-image
    hs-source-dirs:   app
    default-language: GHC2024
